{
    "name": "sixty-nine/php-cloud-lib",
    "description": "A library to generate words clouds in PHP",
    "type": "library",
    "keywords": ["cloud"],
    "license": "MIT",
    "authors": [
        {
            "name": "Daniele Barsotti",
            "email": "github@sixty-nine.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "SixtyNine\\Cloud\\": "src/SixtyNine/Cloud"
        }
    },
    "require": {
        "php": ">=7.2.5",
        "doctrine/collections": "^1.4",
        "jms/serializer": "^1.2",
        "imagine/imagine": "^1.3",
        "symfony/console": "^4.4 || ^5.4 || ^6.4 || ^7.0 || ^8.0",
        "monolog/monolog": "^1.22 || ^2.0 || ^3.0",
        "webmozart/assert": "^1.2",
        "symfony/stopwatch": "^4.4 || ^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^4.4 || ^5.4 || ^6.4 || ^7.0 || ^8.0",
        "sixty-nine/php-data-types": "0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6"
    },
    "config": {
        "bin-dir": "bin"
    }
}
